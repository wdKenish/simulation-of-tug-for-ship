class PINN(torch.nn.Module):

    def __init__(self,n_input, n_output, n_layer, n_nodes):
        super(PINN,self).__init__()
        # 输入层
        self.input_l = torch.nn.Linear(n_input, n_nodes)
        torch.nn.init.xavier_normal_(self.input_l.weight.data,gain=1.0)
        torch.nn.init.normal_(self.input_l.bias.data)
        # 隐藏层
        self.hidden = torch.nn.ModuleList()
        for i in range(n_layer):
            self.hidden.append(torch.nn.Linear(n_nodes, n_nodes))
            torch.nn.init.xavier_normal_(self.hidden[-1].weight.data,gain=1.0)
            torch.nn.init.normal_(self.hidden[-1].bias.data)
        # 输出层
        self.output_l = torch.nn.Linear(n_nodes, n_output)
        torch.nn.init.xavier_normal_(self.output_l.weight.data,gain=1.0)
        torch.nn.init.normal_(self.output_l.bias.data)

    def forward(self,x):
        x = torch.tanh(self.input_l(x))
        for i in self.hidden:
            x = torch.tanh(i(x))
        x = self.output_l(x)
        return x


def dervative(x,net,func,order):
    # u = func_u(x,y)*g(x,y) = F(x,y)
    w = func(x).reshape(-1,1)*net(x)
     
    if order == "0":
        return w
    else:
        dw_xy = torch.autograd.grad(w, x, torch.ones_like(w), retain_graph=True, create_graph=True, allow_unused=True)[0]
        dw_x, dw_y = dw_xy[:,0].reshape(-1,1), dw_xy[:,1].reshape(-1,1)

        if order == "1":
            return w, dw_x, dw_y
        else:
            dw_x_xy = torch.autograd.grad(dw_x, x, torch.ones_like(dw_x), retain_graph=True, create_graph=True, allow_unused=True)[0]
            dw_xx, dw_xy = dw_x_xy[:,0].reshape(-1,1), dw_x_xy[:,1].reshape(-1,1)
            dw_yy = torch.autograd.grad(dw_y, x, torch.ones_like(dw_y), retain_graph=True, create_graph=True, allow_unused=True)[0][:,1].reshape(-1,1)
            return w, dw_x, dw_y, dw_xx, dw_xy, dw_yy


